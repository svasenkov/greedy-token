n hub serve\\n```\\n\\nПовторяющаяся задача → **crystallize** в скрипт → следующий раз **0 LLM**. Подробности: [guide](docs/guide-RU.md) · [roadmap](docs/ROADMAP-RU.md)\\n\\n**Лицензия:** MIT · **v0.10.0**\\n'\n\ntests/test_doc_sync.py:166: AssertionError","start":1785013131489,"stop":1785013131490,"duration":1,"labels":[{"name":"layer","value":"unit"},{"name":"severity","value":"normal"},{"name":"feature","value":"Doc-drift guard"},{"name":"epic","value":"Docs"},{"name":"parentSuite","value":"Docs"},{"name":"suite","value":"Doc-drift guard"},{"name":"story","value":"Confidence calibration"},{"name":"tag","value":"unit"},{"name":"host","value":"runnervmvrwv9"},{"name":"thread","value":"3033-MainThread"},{"name":"framework","value":"pytest"},{"name":"language","value":"cpython3"},{"name":"package","value":"tests.test_doc_sync"}],"url":"","historyId":"bdd148c19555f82dd8051004f801bba9.563382f7a1689e466524b4bfd401b548","reportLinks":[]},{"id":"86760ada8c30c78a0bf8a3be794bfb44","name":"README calibration section matches code constants (threshold + buckets)","fullName":"tests.test_doc_sync#test_readme_calibration_matches_code","environment":"default","status":"passed","start":1785012693597,"stop":1785012693597,"duration":0,"labels":[{"name":"layer","value":"unit"},{"name":"severity","value":"normal"},{"name":"epic","value":"Docs"},{"name":"feature","value":"Doc-drift guard"},{"name":"suite","value":"Doc-drift guard"},{"name":"story","value":"Confidence calibration"},{"name":"parentSuite","value":"Docs"},{"name":"tag","value":"unit"},{"name":"host","value":"runnervmvrwv9"},{"name":"thread","value":"2935-MainThread"},{"name":"framework","value":"pytest"},{"name":"language","value":"cpython3"},{"name":"package","value":"tests.test_doc_sync"}],"url":"","historyId":"bdd148c19555f82dd8051004f801bba9.563382f7a1689e466524b4bfd401b548","reportLinks":[]},{"id":"221d0fb72faad0818cd623dd73726e60","name":"README calibration section matches code constants (threshold + buckets)","fullNa